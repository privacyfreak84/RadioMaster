#!/usr/bin/env python3
# Fake mpv: opens the IPC socket, answers commands, emits start-file/playback-restart on loadfile.
import sys, socket, os, json, threading, time
path = [a.split('=',1)[1] for a in sys.argv if a.startswith('--input-ipc-server=')][0]
if os.path.exists(path): os.remove(path)
srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); srv.bind(path); srv.listen(1)
conn, _ = srv.accept()
f = conn.makefile('r')
for line in f:
    try: msg = json.loads(line)
    except Exception: continue
    cmd = msg.get('command', [])
    conn.sendall((json.dumps({"error": "success"}) + "\n").encode())
    if cmd and cmd[0] == 'loadfile':
        for ev in ("start-file", "playback-restart"):
            time.sleep(0.05)
            conn.sendall((json.dumps({"event": ev}) + "\n").encode())
    if cmd and cmd[0] == 'quit':
        break
